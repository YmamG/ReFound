# Copy to .env once. Generate a unique key; never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Riyadh
# Optional public operator support address (never use a placeholder in production).
REFOUND_SUPPORT_EMAIL=

# Production: DEBUG=False, HTTPS, real domain, persistent database/media paths.
# DJANGO_ALLOWED_HOSTS=refound.example.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://refound.example.org
# DJANGO_DB_PATH=/var/data/refound/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/data/refound/media
# DJANGO_STATIC_ROOT=/app/staticfiles
# SECURE_SSL_REDIRECT defaults True when DEBUG=False.
# DJANGO_SECURE_SSL_REDIRECT=True
# Enable ONLY when your trusted reverse proxy strips client-supplied forwarding
# headers and sets X-Forwarded-Proto itself. Required for many managed HTTPS hosts.
# DJANGO_TRUST_PROXY_SSL_HEADER=True
# Trust only the actual ingress proxy networks, never all IPv4/IPv6 addresses.
# REFOUND_TRUSTED_PROXY_CIDRS=10.20.30.0/24
# REFOUND_RATE_LIMIT=10
# HSTS defaults to 3600 seconds in production. Enable the next options only after
# verifying HTTPS for ALL subdomains and understanding the browser commitments.
# DJANGO_HSTS_SECONDS=3600
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False
